module

public import CollatzMCycles.LogBounds

/-!
# Lemma 3.5: Unimodular one-sided linear-form exclusion (owned by `bootstrap`)

Paper (latex.md, Lemma 3.5): let `(p₊, q₊), (p₋, q₋) ∈ ℤ²_{>0}` with
`p₊ q₋ − p₋ q₊ = 1`, `p₊ − q₊ δ ≥ d_lo > 0` and `p₋ − q₋ δ < 0`. Then every `(P, K) ∈ ℤ²`
with `0 < P − K δ < d_lo` and `K ≥ 1` satisfies `K ≥ q₊ + q₋`.

This file contains
* the integer sign-quadrant core `unimodular_sl2z_quadrant_exclusion` (ported verbatim from
  `lean4_formal_verification/mcycle_reduction_lemmas.lean`),
* its real-valued analogue `quadrant_exclusion_real` and the real-`δ` form
  `unimodular_exclusion` (Lemma 3.5 as stated in the paper),
* the structure `Record` encoding one certified unimodular pair, the executable validity check
  `Record.valid` (determinant, `p₊ − q₊ δ_hi > 0`, `p₋ − q₋ δ_lo < 0`, all in `ℕ`/`ℤ`), and the
  generic `Record.step` theorem: a valid record plus `δ_lo ≤ δ ≤ δ_hi` and
  `0 < P − K δ < d_lo(record)` forces `K ≥ q₊ + q₋`.

The 162 records of `exact_bounds_meta.json["unimodular_records"]` live in
`CollatzMCycles.WitnessData` (generated by `scratch/bootstrap/gen_shiftfree.py`); their validity is
checked once by `decide +kernel`.

Enclosure numerals: `δ_lo`, `δ_hi`, `ln2_lo` are the `LogBounds` rationals (verbatim JSON), re-expressed
as `ℕ` numerators over the fixed denominator `D = 2^220` (`delta_hi`'s reduced denominator is `2^217`,
so its numerator is multiplied by `8`); `deltaHi_eq`/`deltaLo_eq`/`ln2Lo_eq` prove agreement, and
`deltaLo_le_δ`, `δ_le_deltaHi`, `ln2Lo_le_log_two` re-export the `LogBounds` enclosure theorems in
numerator form. `δ := LogBounds.δ = Real.logb 2 3` throughout.
-/

@[expose] public section
namespace CollatzMCycles

open LogBounds (δ)

/-- Fixed dyadic denominator `2^220` for every exact rational enclosure. -/
def D : ℕ := 2 ^ 220

/-- Numerator of `δ_hi = LogBounds.delta_hi` over `D = 2^220`. -/
def deltaHiNum : ℕ := 2670656530554754882264608135970714174812783383528749517525579880920

/-- Numerator of `δ_lo = LogBounds.delta_lo` over `D = 2^220`. -/
def deltaLoNum : ℕ := 2670656530554754882264608135970714174812783383528749517525579880575

/-- Numerator of `ln2_lo = LogBounds.ln2_lo` over `D = 2^220`. -/
def ln2LoNum : ℕ := 1167950688773872517954935089893261764285717328480531383045641523482

theorem D_pos : 0 < D := by unfold D; positivity

theorem D_real_pos : (0 : ℝ) < D := by exact_mod_cast D_pos

theorem deltaHi_eq : (deltaHiNum : ℝ) / D = (LogBounds.delta_hi : ℝ) := by
  unfold LogBounds.delta_hi deltaHiNum D; push_cast; norm_num

theorem deltaLo_eq : (deltaLoNum : ℝ) / D = (LogBounds.delta_lo : ℝ) := by
  unfold LogBounds.delta_lo deltaLoNum D; push_cast; norm_num

theorem ln2Lo_eq : (ln2LoNum : ℝ) / D = (LogBounds.ln2_lo : ℝ) := by
  unfold LogBounds.ln2_lo ln2LoNum D; push_cast; norm_num

/-- `δ_lo ≤ δ` in numerator form (from `LogBounds.delta_lo_le_δ`). -/
theorem deltaLo_le_δ : (deltaLoNum : ℝ) / D ≤ δ := deltaLo_eq ▸ LogBounds.delta_lo_le_δ

/-- `δ ≤ δ_hi` in numerator form (from `LogBounds.δ_le_delta_hi`). -/
theorem δ_le_deltaHi : δ ≤ (deltaHiNum : ℝ) / D := deltaHi_eq ▸ LogBounds.δ_le_delta_hi

/-- `ln2_lo ≤ log 2` in numerator form (from `LogBounds.ln2_lo_le_log_two`). -/
theorem ln2Lo_le_log_two : (ln2LoNum : ℝ) / D ≤ Real.log 2 :=
  ln2Lo_eq ▸ LogBounds.ln2_lo_le_log_two

theorem ln2Lo_pos : (0 : ℝ) < (ln2LoNum : ℝ) / D := by
  have : (0 : ℝ) < ln2LoNum := by exact_mod_cast (by unfold ln2LoNum; norm_num : 0 < ln2LoNum)
  exact div_pos this D_real_pos

theorem one_lt_deltaLo : (1 : ℝ) < (deltaLoNum : ℝ) / D := by
  rw [lt_div_iff₀ D_real_pos, one_mul]
  exact_mod_cast (by unfold D deltaLoNum; norm_num : D < deltaLoNum)

/-! ### The sign-quadrant core (integer version, ported verbatim) -/

/--
Lemma 3.5, integer sign-quadrant core: given `K = u * q_pos + v * q_neg` and
`drift = u * rem_pos + v * rem_neg` with `q_pos > 0`, `q_neg > 0`, `rem_pos > 0`, `rem_neg ≤ 0`,
`K ≥ 1`, and `0 < drift < rem_pos`, all four sign quadrants for `(u, v)` force
`K ≥ q_pos + q_neg`.
-/
theorem unimodular_sl2z_quadrant_exclusion
    (q_pos q_neg rem_pos rem_neg u v K drift : Int)
    (hq_pos : 0 < q_pos) (hq_neg : 0 < q_neg)
    (hrem_pos : 0 < rem_pos) (hrem_neg : rem_neg ≤ 0)
    (hK : K = u * q_pos + v * q_neg)
    (hdrift : drift = u * rem_pos + v * rem_neg)
    (hK_pos : 1 ≤ K)
    (hdrift_pos : 0 < drift)
    (hdrift_lt : drift < rem_pos) :
    q_pos + q_neg ≤ K := by
  by_cases hu : u ≤ 0
  · by_cases hv : v ≤ 0
    · have h1 : u * q_pos ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg hu (Int.le_of_lt hq_pos)
      have h2 : v * q_neg ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg hv (Int.le_of_lt hq_neg)
      omega
    · have hv_pos : 0 ≤ v := by omega
      have h1 : u * rem_pos ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg hu (Int.le_of_lt hrem_pos)
      have h2 : v * rem_neg ≤ 0 := Int.mul_nonpos_of_nonneg_of_nonpos hv_pos hrem_neg
      omega
  · have hu1 : 1 ≤ u := by omega
    by_cases hv : v ≤ 0
    · have h1 : rem_pos ≤ u * rem_pos := by
        have h_sub : 0 ≤ (u - 1) * rem_pos :=
          Int.mul_nonneg (by omega) (Int.le_of_lt hrem_pos)
        have h_id : u * rem_pos = rem_pos + (u - 1) * rem_pos := by
          rw [Int.sub_mul, Int.one_mul]; omega
        omega
      have h2 : 0 ≤ v * rem_neg := Int.mul_nonneg_of_nonpos_of_nonpos hv hrem_neg
      omega
    · have hv1 : 1 ≤ v := by omega
      have h1 : q_pos ≤ u * q_pos := by
        have h_sub : 0 ≤ (u - 1) * q_pos :=
          Int.mul_nonneg (by omega) (Int.le_of_lt hq_pos)
        have h_id : u * q_pos = q_pos + (u - 1) * q_pos := by
          rw [Int.sub_mul, Int.one_mul]; omega
        omega
      have h2 : q_neg ≤ v * q_neg := by
        have h_sub : 0 ≤ (v - 1) * q_neg :=
          Int.mul_nonneg (by omega) (Int.le_of_lt hq_neg)
        have h_id : v * q_neg = q_neg + (v - 1) * q_neg := by
          rw [Int.sub_mul, Int.one_mul]; omega
        omega
      omega

/-! ### Real-valued sign-quadrant core and Lemma 3.5 -/

/--
Lemma 3.5, sign-quadrant core with real remainders: `u, v, K : ℤ`, `rem_pos rem_neg : ℝ`,
`K = u q_pos + v q_neg`, `drift = u rem_pos + v rem_neg`, `rem_pos > 0 ≥ rem_neg`, `K ≥ 1`,
`0 < drift < rem_pos` ⟹ `q_pos + q_neg ≤ K`.
-/
theorem quadrant_exclusion_real
    (q_pos q_neg u v K : ℤ) (rem_pos rem_neg drift : ℝ)
    (hq_pos : 0 < q_pos) (hq_neg : 0 < q_neg)
    (hrem_pos : 0 < rem_pos) (hrem_neg : rem_neg ≤ 0)
    (hK : K = u * q_pos + v * q_neg)
    (hdrift : drift = u * rem_pos + v * rem_neg)
    (hK_pos : 1 ≤ K)
    (hdrift_pos : 0 < drift)
    (hdrift_lt : drift < rem_pos) :
    q_pos + q_neg ≤ K := by
  by_cases hu : u ≤ 0
  · by_cases hv : v ≤ 0
    · have h1 : u * q_pos ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg hu (Int.le_of_lt hq_pos)
      have h2 : v * q_neg ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg hv (Int.le_of_lt hq_neg)
      omega
    · have hv_pos : (0 : ℝ) ≤ v := by exact_mod_cast (by omega : (0 : ℤ) ≤ v)
      have hu' : (u : ℝ) ≤ 0 := by exact_mod_cast hu
      have h1 : (u : ℝ) * rem_pos ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hu' hrem_pos.le
      have h2 : (v : ℝ) * rem_neg ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hv_pos hrem_neg
      linarith
  · have hu1 : (1 : ℝ) ≤ u := by exact_mod_cast (by omega : (1 : ℤ) ≤ u)
    by_cases hv : v ≤ 0
    · have hv' : (v : ℝ) ≤ 0 := by exact_mod_cast hv
      have h1 : rem_pos ≤ u * rem_pos := by nlinarith
      have h2 : 0 ≤ (v : ℝ) * rem_neg := mul_nonneg_of_nonpos_of_nonpos hv' hrem_neg
      linarith
    · have hu1' : 1 ≤ u := by omega
      have hv1 : 1 ≤ v := by omega
      have h1 : q_pos ≤ u * q_pos := by nlinarith
      have h2 : q_neg ≤ v * q_neg := by nlinarith
      omega

/--
**Lemma 3.5** (unimodular one-sided linear-form exclusion), real `δ`.
`p₊ q₋ − p₋ q₊ = 1`, `q₊, q₋ > 0`, `p₊ − q₊ δ ≥ d_lo > 0`, `p₋ − q₋ δ < 0`, `K ≥ 1`,
`0 < P − K δ < d_lo` ⟹ `q₊ + q₋ ≤ K`.
-/
theorem unimodular_exclusion
    (p_pos q_pos p_neg q_neg P K : ℤ) (δ d_lo : ℝ)
    (hdet : p_pos * q_neg - p_neg * q_pos = 1)
    (hq_pos : 0 < q_pos) (hq_neg : 0 < q_neg)
    (hd_lo : 0 < d_lo)
    (hpos : d_lo ≤ p_pos - q_pos * δ)
    (hneg : p_neg - q_neg * δ < 0)
    (hK : 1 ≤ K)
    (h0 : 0 < P - K * δ)
    (h1 : P - K * δ < d_lo) :
    q_pos + q_neg ≤ K := by
  -- unique integer coordinates in the unimodular basis
  set u : ℤ := q_neg * P - p_neg * K with hu
  set v : ℤ := -q_pos * P + p_pos * K with hv
  have hKuv : K = u * q_pos + v * q_neg := by
    rw [hu, hv]; linear_combination (-K) * hdet
  have hPuv : P = u * p_pos + v * p_neg := by
    rw [hu, hv]; linear_combination (-P) * hdet
  have hdrift : P - K * δ = u * (p_pos - q_pos * δ) + v * (p_neg - q_neg * δ) := by
    have hK' : (K : ℝ) = u * q_pos + v * q_neg := by exact_mod_cast hKuv
    have hP' : (P : ℝ) = u * p_pos + v * p_neg := by exact_mod_cast hPuv
    rw [hK', hP']; ring
  exact quadrant_exclusion_real q_pos q_neg u v K (p_pos - q_pos * δ) (p_neg - q_neg * δ)
    (P - K * δ) hq_pos hq_neg (lt_of_lt_of_le hd_lo hpos) hneg.le hKuv hdrift hK h0
    (lt_of_lt_of_le h1 hpos)

/-! ### Certified records -/

/-- One certified unimodular pair `(p₊, q₊, p₋, q₋)` (`exact_bounds_meta.json["unimodular_records"]`,
fields `p_pos q_pos p_neg q_neg`); `k_next = q₊ + q₋`, `d_lo = p₊ − q₊ δ_hi`. -/
structure Record where
  p_pos : ℕ
  q_pos : ℕ
  p_neg : ℕ
  q_neg : ℕ
  deriving Repr, DecidableEq

namespace Record

/-- `k_next = q₊ + q₋`. -/
def kNext (r : Record) : ℕ := r.q_pos + r.q_neg

/-- Numerator of `d_lo = p₊ − q₊ δ_hi` over `D` (as `ℤ`; positive for valid records). -/
def dLoNum (r : Record) : ℤ := (r.p_pos : ℤ) * D - r.q_pos * deltaHiNum

/-- `d_lo = p₊ − q₊ δ_hi` as a real number. -/
noncomputable def dLo (r : Record) : ℝ := (r.p_pos : ℝ) - r.q_pos * ((deltaHiNum : ℝ) / D)

/-- Executable validity: `det = 1`, `q₊, q₋ > 0`, `p₊ − q₊ δ_hi > 0`, `p₋ − q₋ δ_lo < 0`. -/
def valid (r : Record) : Bool :=
  (r.p_pos : ℤ) * r.q_neg - r.p_neg * r.q_pos == 1 && 0 < r.q_pos && 0 < r.q_neg &&
    r.q_pos * deltaHiNum < r.p_pos * D && r.p_neg * D < r.q_neg * deltaLoNum

theorem dLo_eq (r : Record) : r.dLo = (r.dLoNum : ℝ) / D := by
  unfold dLo dLoNum
  have := D_pos
  push_cast
  field_simp

theorem valid_iff (r : Record) :
    r.valid = true ↔ ((r.p_pos : ℤ) * r.q_neg - r.p_neg * r.q_pos = 1 ∧ 0 < r.q_pos ∧
      0 < r.q_neg ∧ r.q_pos * deltaHiNum < r.p_pos * D ∧ r.p_neg * D < r.q_neg * deltaLoNum) := by
  unfold valid
  simp [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, and_assoc]

/--
Generic bootstrap step: a valid record, `δ_lo ≤ δ ≤ δ_hi`, `K ≥ 1` and
`0 < P − K δ < d_lo(record)` force `K ≥ k_next = q₊ + q₋`.
-/
theorem step (r : Record) (hr : r.valid = true)
    (P K : ℕ) (hK : 1 ≤ K)
    (h0 : 0 < (P : ℝ) - K * δ) (h1 : (P : ℝ) - K * δ < r.dLo) :
    r.kNext ≤ K := by
  obtain ⟨hdet, hqp, hqn, hdpos, hdneg⟩ := (valid_iff r).1 hr
  have hδlo := deltaLo_le_δ
  have hδhi := δ_le_deltaHi
  have hD : (0 : ℝ) < D := by exact_mod_cast D_pos
  have hdlo_pos : 0 < r.dLo := by
    unfold dLo
    have : (r.q_pos : ℝ) * deltaHiNum < r.p_pos * D := by exact_mod_cast hdpos
    rw [sub_pos, mul_div_assoc', div_lt_iff₀ hD]; linarith
  have hpos : r.dLo ≤ (r.p_pos : ℝ) - r.q_pos * δ := by
    unfold dLo
    have hq : (0 : ℝ) ≤ r.q_pos := by positivity
    nlinarith
  have hneg : (r.p_neg : ℝ) - r.q_neg * δ < 0 := by
    have h1 : (r.p_neg : ℝ) * D < r.q_neg * deltaLoNum := by exact_mod_cast hdneg
    have h2 : (r.p_neg : ℝ) < r.q_neg * ((deltaLoNum : ℝ) / D) := by
      rw [mul_div_assoc', lt_div_iff₀ hD]; linarith
    have hq : (0 : ℝ) ≤ r.q_neg := by positivity
    nlinarith
  have key := unimodular_exclusion r.p_pos r.q_pos r.p_neg r.q_neg P K δ r.dLo hdet
    (by exact_mod_cast hqp) (by exact_mod_cast hqn) hdlo_pos (by push_cast; exact hpos)
    (by push_cast; exact hneg) (by exact_mod_cast hK) (by push_cast; exact h0)
    (by push_cast; exact h1)
  unfold kNext
  exact_mod_cast key

end Record

end CollatzMCycles
